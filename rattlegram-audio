#!/usr/bin/env python3
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

from payload import MAX_FILE, Reassembler, file_packets, packets
from settings import load_cipher, load_settings

BIN = Path(__file__).resolve().parent / "bin"


def send(frames, callsign, audio):
    codec_args = audio.codec_args() + [str(audio.noise_symbols), str(audio.carrier_frequency)]
    with subprocess.Popen(audio.pacat_args() + ["--playback", "--device=@DEFAULT_SINK@"],
                          stdin=subprocess.PIPE) as player:
        with player.stdin:
            for frame in frames:
                encoder = subprocess.run([BIN / "send-pcm", frame, callsign, *codec_args],
                                         stdout=player.stdin)
                if encoder.returncode:
                    return 1
        return int(bool(player.wait()))


def messages(stream):
    pending = b""
    while chunk := stream.read1(4096):
        *complete, pending = (pending + chunk).split(b"\0")
        yield from complete
    if pending:
        raise ValueError("Decoder returned an incomplete message.")


def save_file(output, data):
    with tempfile.TemporaryDirectory(dir=output.parent) as temporary:
        staged = Path(temporary) / "received"
        staged.write_bytes(data)
        os.link(staged, output)


def report_file_start(sender, transfer_id, count):
    details = f", ID {transfer_id}" if transfer_id else ""
    print(f"File transfer started: {sender}, packets: {count}{details}", file=sys.stderr)


def listen(cipher, require_encryption, output, receive_dir, audio, verbose):
    if output is not None and os.path.lexists(output):
        raise ValueError(f"Destination already exists: {output}")
    reassembler = Reassembler(cipher, require_encryption, report_file_start)
    with subprocess.Popen(audio.pacat_args() + ["--record", "--device=@DEFAULT_SOURCE@", "--latency-msec=50"],
                          stdout=subprocess.PIPE) as recorder:
        try:
            with subprocess.Popen([BIN / "listen-pcm", "--metadata", *audio.codec_args()], stdin=recorder.stdout,
                                  stdout=subprocess.PIPE) as decoder:
                recorder.stdout.close()
                try:
                    for frame in messages(decoder.stdout):
                        callsign, corrections, packet = frame.split(b"\t", 2)
                        sender = callsign.decode("ascii").strip() or "Unknown"
                        if verbose:
                            print(f"Reception {sender}: {int(corrections)} corrected payload bits",
                                  file=sys.stderr)
                        try:
                            transfer = reassembler.receive(packet, sender)
                        except ValueError as exc:
                            print(f"Transfer rejected: {exc}", file=sys.stderr)
                            continue
                        if transfer is None:
                            continue
                        expected = audio.gpg_signers.get(sender)
                        if transfer.signers and expected and expected not in transfer.signers:
                            print(f"Transfer rejected: {sender} must use the configured GPG signing key.",
                                  file=sys.stderr)
                            continue
                        if transfer.signers:
                            print(f"Valid GPG signature: {transfer.signers[0]}", file=sys.stderr)
                        elif expected:
                            print(f"Unsigned transfer from {sender}", file=sys.stderr)
                        if isinstance(transfer.data, bytes):
                            if output is not None:
                                save_file(output, transfer.data)
                                print(f"File from {sender} saved: {output}", file=sys.stderr)
                                return 0
                            receive_dir.mkdir(parents=True, exist_ok=True)
                            transfer_id = transfer.transfer_id or os.urandom(8).hex()
                            target = receive_dir / f"rattlegram-{transfer_id}.bin"
                            try:
                                save_file(target, transfer.data)
                            except OSError as exc:
                                print(f"Could not save file: {exc}", file=sys.stderr)
                            else:
                                print(f"File from {sender} saved: {target}", file=sys.stderr)
                        else:
                            sys.stdout.buffer.write(f"{sender}: {transfer.data}\n".encode("utf-8"))
                            sys.stdout.buffer.flush()
                    decoder.wait()
                finally:
                    if decoder.poll() is None:
                        decoder.terminate()
            recorder_running = recorder.poll() is None
        finally:
            if recorder.poll() is None:
                recorder.terminate()
    if output is not None:
        raise ValueError("Audio input ended before the file transfer completed.")
    return int(bool(recorder_running or recorder.returncode or decoder.returncode))


def send_fingerprint(option, keys, fallback, missing):
    if option is None:
        return None
    if not option:
        if fallback is None:
            raise ValueError(missing)
        return fallback
    return keys.get(option.upper(), option)


def main():
    parser = argparse.ArgumentParser()
    modes = parser.add_subparsers(dest="mode", required=True)
    tx = modes.add_parser("send")
    tx.add_argument("-c", "--compress", action="store_true", help="Enable zlib compression")
    tx.add_argument("-n", "--no-length-limit", action="store_true",
                    help="Split long messages across multiple packets")
    source = tx.add_mutually_exclusive_group(required=True)
    source.add_argument("message", nargs="?")
    source.add_argument("-f", "--file", type=Path, metavar="FILE",
                        help="Transfer a file byte for byte")
    tx.add_argument("-g", "--gpg-encrypt", nargs="?", const="", metavar="NAME_OR_FINGERPRINT",
                    help="Encrypt to an OpenPGP recipient by name or fingerprint")
    tx.add_argument("-s", "--gpg-sign", nargs="?", const="", metavar="NAME_OR_FINGERPRINT",
                    help="Sign by name or fingerprint, defaulting to the sender call sign")
    tx.add_argument("callsign")
    rx = modes.add_parser("listen")
    rx.add_argument("-v", "--verbose", action="store_true",
                    help="Report reception quality for each decoded packet")
    targets = rx.add_mutually_exclusive_group()
    targets.add_argument("-o", "--output", type=Path, metavar="FILE",
                         help="Save one received file and exit")
    targets.add_argument("-d", "--receive-dir", type=Path, metavar="DIR",
                         help="Directory for received files (default: ~/.rattlegram-audio/receieved)")
    tx.add_argument("-e", "--encrypt", action="store_true",
                    help="Encrypt with ChaCha20-Poly1305")
    keys = rx.add_mutually_exclusive_group()
    keys.add_argument("-e", "--encrypt", action="store_true",
                      help="Receive only authenticated transfers")
    keys.add_argument("-k", "--key-file", action="store_true",
                      help="Require the local key and accept both encrypted and unencrypted transfers")
    args = parser.parse_args()
    if args.mode == "send" and args.file is not None and args.compress:
        tx.error("--compress cannot be used with --file.")

    if args.mode == "send" and args.encrypt and args.gpg_encrypt is not None:
        tx.error("--encrypt cannot be used with --gpg-encrypt.")

    try:
        directory = Path.home() / ".rattlegram-audio"
        audio = load_settings(directory)
        use_key = args.encrypt
        if args.mode == "listen":
            use_key = use_key or args.key_file or os.path.lexists(directory / "key")
        cipher = load_cipher(directory) if use_key else None
        if not os.access(BIN / f"{args.mode}-pcm", os.X_OK):
            raise ValueError("Run make in the program directory first.")
        if not shutil.which("pacat"):
            raise ValueError("pacat is missing. Install pulseaudio-utils.")
        if args.mode == "send":
            signer = send_fingerprint(
                args.gpg_sign, audio.gpg_keys,
                audio.gpg_keys.get(args.callsign.upper(), audio.gpg_signer),
                f"Add {args.callsign.upper()} to [gpg] in config.ini or pass a signing fingerprint.")
            recipient = send_fingerprint(
                args.gpg_encrypt, audio.gpg_keys, audio.gpg_recipient,
                "Specify a recipient name from [gpg] in config.ini or pass a fingerprint.")
            if args.file is not None:
                with args.file.open("rb") as source_file:
                    data = source_file.read(MAX_FILE + 1)
                frames = list(file_packets(data, cipher, recipient, signer))
            else:
                frames = list(packets(args.message, args.compress, cipher, args.no_length_limit,
                                      recipient, signer))
            return send(frames, args.callsign, audio)
        receive_dir = args.receive_dir or directory / "receieved"
        return listen(cipher, args.encrypt, args.output, receive_dir, audio, args.verbose)
    except ImportError:
        print("Encryption requires the Python cryptography package.", file=sys.stderr)
        return 1
    except (OSError, ValueError) as exc:
        print(exc, file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
