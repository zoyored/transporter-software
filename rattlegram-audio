#!/usr/bin/env python3
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys

from payload import MAX_MESSAGE, Reassembler, load_cipher, packets

BIN = Path(__file__).resolve().parent / "bin"
PCM = ["pacat", "--raw", "--rate=8000", "--format=s16ne", "--channels=1"]


def send(frames, callsign):
    with subprocess.Popen(PCM + ["--playback", "--device=@DEFAULT_SINK@"],
                          stdin=subprocess.PIPE) as player:
        with player.stdin:
            for frame in frames:
                encoder = subprocess.run([BIN / "send-pcm", frame, callsign],
                                         stdout=player.stdin)
                if encoder.returncode:
                    return 1
        return int(bool(player.wait()))


def messages(stream):
    pending = b""
    while chunk := stream.read1(4096):
        *complete, pending = (pending + chunk).split(b"\0")
        yield from complete
    if pending:
        raise ValueError("Decoder lieferte eine unvollständige Nachricht.")


def listen(cipher):
    reassembler = Reassembler()
    with subprocess.Popen(PCM + ["--record", "--device=@DEFAULT_SOURCE@", "--latency-msec=50"],
                          stdout=subprocess.PIPE) as recorder:
        try:
            with subprocess.Popen([BIN / "listen-pcm", "--frames"], stdin=recorder.stdout,
                                  stdout=subprocess.PIPE) as decoder:
                recorder.stdout.close()
                try:
                    for packet in messages(decoder.stdout):
                        try:
                            message = reassembler.receive(packet, cipher)
                        except ValueError as exc:
                            print(f"Empfang verworfen: {exc}", file=sys.stderr)
                            continue
                        if message is None:
                            continue
                        sys.stdout.buffer.write(message.encode("utf-8") + b"\n")
                        sys.stdout.buffer.flush()
                    decoder.wait()
                finally:
                    if decoder.poll() is None:
                        decoder.terminate()
            recorder_running = recorder.poll() is None
        finally:
            if recorder.poll() is None:
                recorder.terminate()
    return int(bool(recorder_running or recorder.returncode or decoder.returncode))


def read_message_file(path):
    pdf = path.suffix.lower() == ".pdf"
    if pdf:
        if not shutil.which("pdftotext"):
            raise ValueError("Für PDF-Dateien wird pdftotext aus poppler-utils benötigt.")
        command = ["pdftotext", "-layout", "-enc", "UTF-8", "-nopgbrk",
                   os.path.abspath(path), "-"]
        with subprocess.Popen(command, stdout=subprocess.PIPE) as converter:
            try:
                data = converter.stdout.read(MAX_MESSAGE + 1)
                if len(data) <= MAX_MESSAGE and converter.wait():
                    raise ValueError("Der Text konnte nicht aus der PDF-Datei gelesen werden.")
            finally:
                if converter.poll() is None:
                    converter.kill()
    else:
        with path.open("rb") as source_file:
            data = source_file.read(MAX_MESSAGE + 1)
    if len(data) > MAX_MESSAGE:
        raise ValueError(f"Der Nachrichtentext überschreitet das Limit von {MAX_MESSAGE} UTF-8-Bytes.")
    message = data.decode("utf-8")
    if pdf and not message.strip():
        raise ValueError("Die PDF-Datei enthält keinen extrahierbaren Text.")
    return message


def main():
    parser = argparse.ArgumentParser()
    modes = parser.add_subparsers(dest="mode", required=True)
    tx = modes.add_parser("send")
    tx.add_argument("--compress", action="store_true", help="zlib-Kompression aktivieren")
    tx.add_argument("--no-length-limit", action="store_true",
                    help="Einzelpaketlimit aufheben und lange Nachrichten fragmentieren")
    source = tx.add_mutually_exclusive_group(required=True)
    source.add_argument("message", nargs="?")
    source.add_argument("--file", type=Path, metavar="DATEI",
                        help="Nachricht aus einer UTF-8-Textdatei oder PDF lesen")
    tx.add_argument("callsign")
    rx = modes.add_parser("listen")
    for mode in (tx, rx):
        mode.add_argument("--encrypt", type=Path, metavar="SCHLÜSSELDATEI",
                          help="ChaCha20-Poly1305 mit gemeinsamem Schlüssel verwenden")
    args = parser.parse_args()

    try:
        cipher = load_cipher(args.encrypt) if args.encrypt else None
        if not os.access(BIN / f"{args.mode}-pcm", os.X_OK):
            raise ValueError("Bitte zuerst make im Programmverzeichnis ausführen.")
        if not shutil.which("pacat"):
            raise ValueError("pacat fehlt. Bitte pulseaudio-utils installieren.")
        if args.mode == "send":
            message = args.message
            fragment = args.no_length_limit or args.file is not None
            if args.file is not None:
                message = read_message_file(args.file)
            frames = list(packets(message, args.compress, cipher, fragment))
            return send(frames, args.callsign)
        return listen(cipher)
    except ImportError:
        print("Für Verschlüsselung wird Python cryptography benötigt.", file=sys.stderr)
        return 1
    except (OSError, ValueError) as exc:
        print(exc, file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
